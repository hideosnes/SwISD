# 1. Relative path: systemd/swisd-app.service
# 2. Description: Runs the headless SwISD core as a hardened, self-restarting systemd service.
# 3. Expects: Node 22 at /usr/local/bin/node, app deployed at /opt/swisd/current, swisd system user.
# 4. Provides: The always-on swarm node with strict filesystem isolation and journal logging.
# 5. SPDX-License-Identifier: MPL-2.0
# 6. Copyright (c) 2026 SwISD Collective

[Unit]
Description=SwISD Decentralized AI Swarm Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swisd
Group=swisd
WorkingDirectory=/opt/swisd/current
Environment=NODE_ENV=production
Environment=SWISD_STATE_DIR=/opt/swisd/state
Environment=SWISD_DELIVERY_ROOT=/opt/swisd
ExecStart=/usr/local/bin/node dist/index.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/swisd/state /opt/swisd/models

[Install]
WantedBy=multi-user.target