# .env
# Description: Local development environment for the SwISD observation deck.
# Expects: Used by `npm run start:env` via Node `--env-file`.
# Provides: Safe local admin endpoint configuration for testing before Raspberry Pi delivery.

NODE_ENV=development
SWISD_VERSION=0.0.1
SWISD_ROLE=auto
SWISD_DEV_PEER_ID=dev-local-alpha

SWISD_ADMIN_HOST=127.0.0.1
SWISD_ADMIN_PORT=9182
SWISD_ADMIN_TOKEN=local-dev-1234567890
SWISD_ALLOW_LAN_ADMIN=false
SWISD_ADMIN_CORS=true