# 1. Relative path: .env
# 2. Description: Local development environment for the SwISD observation deck.
# 3. Expects: Used by `npm run start:env` via Node `--env-file`.
# 4. Provides: Safe local admin endpoint configuration and delivery root for testing.

NODE_ENV=development
SWISD_VERSION=0.0.1
SWISD_ROLE=auto
# SWISD_DEV_PEER_ID=dev-local-alpha

SWISD_ADMIN_HOST=127.0.0.1
SWISD_ADMIN_PORT=9182
SWISD_ADMIN_TOKEN=local-dev-1234567890
SWISD_ALLOW_LAN_ADMIN=false
SWISD_ADMIN_CORS=true

SWISD_DELIVERY_ROOT=.swisd/delivery

# Huggingface Write Token
HF_ACCESS_TOKEN=hf_12345...