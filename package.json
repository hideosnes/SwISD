{
  "_doc": [
    "1. Relative path: package.json",
    "2. Description: Root manifest for the SwISD decentralized AI swarm core.",
    "3. Expects: Node 22+ runtime, strict ESM, and local workspace tooling.",
    "4. Provides: Entrypoints, build scripts, and dependency resolution for the headless core.",
    "5. SPDX-License-Identifier: MPL-2.0",
    "6. Copyright (c) 2026 Homahuki GmbH"
  ],
  "name": "swisd",
  "version": "0.0.1",
  "description": "SwISD is a p2p network for decentralized AI inference",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:env": "node --env-file=.env --import tsx src/index.ts",
    "dev": "nodemon --exec tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "release:sign": "tsx scripts/sign-release.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/hideosnes/swisd.git"
  },
  "author": "Hidéo Snes, Homahuki GmbH, 2026",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@huggingface/transformers": "^4.3.0",
    "@libp2p/gossipsub": "17.0.1",
    "@libp2p/mdns": "12.0.30",
    "@libp2p/ping": "^3.1.12",
    "@libp2p/tcp": "11.0.27",
    "@noble/hashes": "^2.4.0",
    "bonjour-service": "^1.4.4",
    "libp2p": "3.3.9",
    "open": "11.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "nodemon": "3.1.14",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.33.5"
  }
}
