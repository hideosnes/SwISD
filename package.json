    "build": "tsc --noEmit false",
    "release:sign": "tsx scripts/sign-release.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/homahuki/swisd.git"
  },
  "author": "Hidéo Snes, Homahuki GmbH, 2026",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@libp2p/gossipsub": "^17.0.1",
    "@libp2p/mdns": "^12.0.11",
    "@libp2p/noise": "^1.0.1",
    "@libp2p/tcp": "^11.0.10",
    "@libp2p/yamux": "^8.0.1",
    "libp2p": "^3.1.3",
    "open": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
