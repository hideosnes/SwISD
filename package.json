{
  "name": "swisd",
  "version": "0.0.1",
  "description": "SwISD is a p2p network for decentralized AI inference",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:env": "node --env-file=.env --import tsx src/index.ts",
    "dev": "nodemon --exec tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc --noEmit false",
    "release:sign": "tsx scripts/sign-release.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/hideosnes/swisd.git"
  },
  "author": "Hidéo Snes, Homahuki GmbH, 2026",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@huggingface/transformers": "4.2.0",
    "@libp2p/gossipsub": "17.0.1",
    "@libp2p/mdns": "12.0.30",
    "@libp2p/ping": "^3.1.12",
    "@libp2p/tcp": "11.0.27",
    "bonjour-service": "^1.4.4",
    "libp2p": "3.3.9",
    "open": "11.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "nodemon": "3.1.14",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "sharp": "^0.33.5"
  }
}
