{
  "name": "swisd",
  "version": "0.0.1",
  "description": "SwISD is a p2p network for decentralized AI inference",
  "main": "index.js",
  "scripts": {
    "start": "ts-node --esm src/index.ts",
    "start:env": "node --env-file=.env --loader ts-node/esm src/index.ts",
    "dev": "nodemon --exec ts-node --esm src/index.ts",
