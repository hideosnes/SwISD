{
  "name": "swisd",
  "description": "SwISD is a p2p network for decentralized AI inference",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:env": "node --env-file=.env --import tsx src/index.ts",
    "dev": "nodemon --exec tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc --noEmit false",
    "release:sign": "tsx scripts/sign-release.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/homahuki/swisd.git"
  },
  "author": "Hidéo Snes, Homahuki GmbH, 2026",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@libp2p/gossipsub": "^17.0.1",
    "@libp2p/mdns": "^12.0.11",
    "@libp2p/noise": "^14.0.0",
    "@libp2p/tcp": "^11.0.10",
    "@libp2p/yamux": "^8.0.1",
    "libp2p": "^3.1.3",
    "open": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
