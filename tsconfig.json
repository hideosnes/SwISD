{
  "compilerOptions": {
    "target": "ES2020",                 
    "module": "NodeNext",
    "moduleResolution": "NodeNext",                 
    "outDir": "./dist",                 
    "rootDir": "./src",                 
    "strict": true,                     
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,        
    "skipLibCheck": false,               
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "ts-node": {
    "transpileOnly": false,
    "esm": true
  },

  "include": ["src/**/*"],             
  "exclude": ["node_modules", "dist"]
}